{
  "name": "alphabet-trains-google-ads-copilot",
  "version": "1.0.0",
  "description": "Safety-constrained agentic Google Ads Co-Pilot for Retail PMax",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "concurrently --names 'API,WORKER' --prefix-colors 'cyan,yellow' 'node dist/index.js' 'node dist/worker.js'",
    "start:all": "concurrently --names 'API,WORKER' --prefix-colors 'cyan,yellow' 'tsx src/index.ts' 'tsx src/worker.ts'",
    "dev": "concurrently --names 'API,WORKER' --prefix-colors 'cyan,yellow' 'tsx watch src/index.ts' 'tsx watch src/worker.ts'",
    "dev:api": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:down": "tsx src/db/migrate.ts down",
    "seed": "tsx src/db/seed.ts",
    "worker": "tsx src/worker.ts",
    "api": "tsx src/api/server.ts",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-ads/api": "^0.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "google-ads-api": "^14.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.13",
    "pg": "^8.12.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
