# =============================================================================
# PRODUCTION ENVIRONMENT - ALL REQUIRED
# =============================================================================
# Copy to .env on your production server
# Generate secrets with: openssl rand -hex 32
# =============================================================================

NODE_ENV=production

# =============================================================================
# DATABASE (Required)
# =============================================================================
DATABASE_URL=postgresql://username:password@your-db-host:5432/alphabet_trains

# =============================================================================
# AUTHENTICATION (Required - generate secure values!)
# =============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your_64_character_minimum_jwt_secret_generate_with_openssl_rand

# Generate with: openssl rand -hex 16
ADMIN_TOKEN=your_32_character_minimum_admin_token

# HTTP Basic Auth - browser will prompt for this before showing the site
BASIC_AUTH_USER=alphabet_admin
BASIC_AUTH_PASS=your_secure_password_16chars

# =============================================================================
# GOOGLE ADS API (Required for real campaigns)
# =============================================================================
# Get from: https://developers.google.com/google-ads/api/docs/get-started/oauth-cloud-project
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# =============================================================================
# MERCHANT CENTER (Optional)
# =============================================================================
MERCHANT_CENTER_ID=

# =============================================================================
# EMAIL NOTIFICATIONS (Recommended)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
NOTIFICATION_FROM=noreply@alphabet-trains.com
NOTIFICATION_TO=admin@alphabet-trains.com

# =============================================================================
# SLACK NOTIFICATIONS (Optional)
# =============================================================================
SLACK_WEBHOOK_URL=

# =============================================================================
# APPLICATION
# =============================================================================
PORT=3000
LOG_LEVEL=warn
TRUST_PROXY=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
