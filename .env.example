# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/alphabet_trains
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Google Ads API Configuration
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_client_id
GOOGLE_ADS_CLIENT_SECRET=your_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_CUSTOMER_ID=your_customer_id
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_login_customer_id

# Google Merchant Center (optional, stub if not available)
MERCHANT_CENTER_ID=your_merchant_center_id

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_64_chars
ADMIN_TOKEN=your_admin_token_for_api_auth

# Email Notifications (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
NOTIFICATION_FROM=noreply@alphabettrains.com
NOTIFICATION_TO=admin@alphabettrains.com

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Application Settings
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Kill Switch (can be toggled via API, but this is the startup default)
KILL_SWITCH_ENABLED=false
