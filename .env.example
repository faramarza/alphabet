# =============================================================================
# Alphabet Trains - Google Ads Co-Pilot Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment
# cp .env.example .env
# =============================================================================

# =============================================================================
# DATABASE (Required)
# =============================================================================
# Option 1: Use a full connection string
# DATABASE_URL=postgresql://username:password@localhost:5432/alphabet_trains

# Option 2: Use individual parameters (these are the defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alphabet_trains
DB_USER=postgres
DB_PASSWORD=

# Connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# =============================================================================
# AUTHENTICATION
# =============================================================================
# These have development defaults - CHANGE FOR PRODUCTION!

# JWT secret for signing tokens (min 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=dev-jwt-secret-change-in-production-min32chars

# Admin token for API authentication (min 16 characters)
# This is what you enter in the web UI to authenticate
ADMIN_TOKEN=dev-admin-token-16

# =============================================================================
# GOOGLE ADS API (Optional - leave empty for stub/demo mode)
# =============================================================================
# The system works in STUB MODE if these are not configured.
# Stub mode uses mock campaign data for testing/development.
#
# Get credentials from: https://developers.google.com/google-ads/api/docs/first-call/overview
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# =============================================================================
# MERCHANT CENTER (Optional - leave empty for stub mode)
# =============================================================================
MERCHANT_CENTER_ID=

# =============================================================================
# EMAIL NOTIFICATIONS (Optional - logs to console if not configured)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM=
NOTIFICATION_TO=

# =============================================================================
# SLACK NOTIFICATIONS (Optional)
# =============================================================================
SLACK_WEBHOOK_URL=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Kill Switch (can be toggled via API, this is just the startup default)
KILL_SWITCH_ENABLED=false
